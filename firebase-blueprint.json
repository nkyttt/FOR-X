{
  "entities": {
    "category": {
      "title": "Category",
      "description": "Storefront product category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "iconKey": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 500 },
        "displayOrder": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "active"]
    },
    "product": {
      "title": "Product",
      "description": "Storefront product with affiliate Buy Now link",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "price": { "type": "number" },
        "rating": { "type": "number" },
        "categoryId": { "type": "string" },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "affiliateLink": { "type": "string", "maxLength": 1000 },
        "active": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "displayOrder": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "description", "price", "rating", "categoryId", "imageUrl", "affiliateLink", "active"]
    },
    "video": {
      "title": "StoreVideo",
      "description": "Promotional or gameplay video asset",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "videoUrl": { "type": "string", "maxLength": 1000 },
        "thumbnailUrl": { "type": "string", "maxLength": 1000 },
        "active": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "displayOrder": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "videoUrl", "active"]
    },
    "banner": {
      "title": "Banner",
      "description": "Storefront promotional banner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 500 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "ctaText": { "type": "string", "maxLength": 100 },
        "ctaUrl": { "type": "string", "maxLength": 500 },
        "active": { "type": "boolean" },
        "displayOrder": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "imageUrl", "active"]
    },
    "storeSettings": {
      "title": "StoreSettings",
      "description": "Storefront metadata, contact, and maintenance mode configuration",
      "type": "object",
      "properties": {
        "storeName": { "type": "string", "maxLength": 100 },
        "logoUrl": { "type": "string", "maxLength": 1000 },
        "faviconUrl": { "type": "string", "maxLength": 1000 },
        "description": { "type": "string", "maxLength": 1000 },
        "contactEmail": { "type": "string", "maxLength": 100 },
        "contactPhone": { "type": "string", "maxLength": 50 },
        "footerText": { "type": "string", "maxLength": 500 },
        "currency": { "type": "string", "maxLength": 10 },
        "maintenanceMode": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["storeName"]
    },
    "themeSettings": {
      "title": "ThemeSettings",
      "description": "Storefront visual appearance and theme customization",
      "type": "object",
      "properties": {
        "primaryColor": { "type": "string", "maxLength": 30 },
        "secondaryColor": { "type": "string", "maxLength": 30 },
        "accentColor": { "type": "string", "maxLength": 30 },
        "backgroundColor": { "type": "string", "maxLength": 30 },
        "textColor": { "type": "string", "maxLength": 30 },
        "borderRadius": { "type": "string", "maxLength": 20 },
        "buttonStyle": { "type": "string", "maxLength": 20 },
        "cardStyle": { "type": "string", "maxLength": 20 },
        "appearance": { "type": "string", "maxLength": 20 },
        "updatedAt": { "type": "string" }
      },
      "required": ["primaryColor", "secondaryColor", "appearance"]
    },
    "globalChatMessage": {
      "title": "GlobalChatMessage",
      "description": "Global gaming community real-time chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 60 },
        "displayName": { "type": "string", "maxLength": 80 },
        "avatarUrl": { "type": "string", "maxLength": 1000 },
        "role": { "type": "string", "maxLength": 30 },
        "userLevel": { "type": "number" },
        "badge": { "type": "string", "maxLength": 50 },
        "content": { "type": "string", "minLength": 1, "maxLength": 500 },
        "channel": { "type": "string", "enum": ["general", "lfg", "gear", "esports"] },
        "reactions": { "type": "object" },
        "createdAt": { "type": "string" },
        "isSystem": { "type": "boolean" }
      },
      "required": ["userId", "username", "content", "channel"]
    },
    "post": {
      "title": "Post",
      "description": "Community feed post with text and optional media",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "text": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string" },
        "gameTag": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["authorId", "text"]
    },
    "postLike": {
      "title": "PostLike",
      "description": "User like on a community post",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "postComment": {
      "title": "PostComment",
      "description": "User comment on a community post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "text"]
    }
  },
  "firestore": {
    "/categories/{categoryId}": {
      "schema": { "$ref": "category" },
      "description": "Collection of storefront product categories"
    },
    "/products/{productId}": {
      "schema": { "$ref": "product" },
      "description": "Collection of storefront products"
    },
    "/videos/{videoId}": {
      "schema": { "$ref": "video" },
      "description": "Collection of promotional and store videos"
    },
    "/banners/{bannerId}": {
      "schema": { "$ref": "banner" },
      "description": "Collection of homepage promotional banners"
    },
    "/storeSettings/{document}": {
      "schema": { "$ref": "storeSettings" },
      "description": "Singleton store settings configuration document"
    },
    "/themeSettings/{document}": {
      "schema": { "$ref": "themeSettings" },
      "description": "Singleton theme settings configuration document"
    },
    "/global_chat_messages/{messageId}": {
      "schema": { "$ref": "globalChatMessage" },
      "description": "Real-time global gaming community chat messages"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "post" },
      "description": "Real Firestore community posts"
    },
    "/posts/{postId}/likes/{userId}": {
      "schema": { "$ref": "postLike" },
      "description": "Real Firestore likes on community post"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "postComment" },
      "description": "Real Firestore comments on community post"
    }
  }
}
